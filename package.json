{
  "name": "pixel-town",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"pnpm --filter @pixel-town/server dev\" \"pnpm --filter @pixel-town/client dev\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @pixel-town/server test",
    "db:generate": "pnpm --filter @pixel-town/server db:generate",
    "db:migrate": "pnpm --filter @pixel-town/server db:migrate",
    "db:studio": "pnpm --filter @pixel-town/server db:studio",
    "db:seed": "pnpm --filter @pixel-town/server db:seed",
    "db:import-json": "pnpm --filter @pixel-town/server db:import-json",
    "check-map": "pnpm --filter @pixel-town/server check-map",
    "snapshot:export": "pnpm --filter @pixel-town/server snapshot:export",
    "snapshot:import": "pnpm --filter @pixel-town/server snapshot:import"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0"
  }
}
