# All variables are validated at boot (src/config/env.ts); the server exits with a
# clear message if something required is missing. Server-only: never sent to the browser.

# Anthropic API key.
ANTHROPIC_API_KEY=
# 1 = deterministic mock LLM (no key needed; the on-stage fallback).
# 0 = live Claude calls. With no key set the server falls back to mock automatically.
MOCK_LLM=0
# Optional: override the model (default claude-haiku-4-5-20251001).
# LLM_MODEL=
PORT=3001

# Where world state and memories live: postgres (default) or memory (in-process,
# nothing persists; for tests and offline use).
STORE=postgres
# Neon POOLED connection string (host contains "-pooler"). Used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon DIRECT connection string (same host without "-pooler"). Used only by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Tests: a dedicated, disposable database (Neon branch or local pgvector container).
# Postgres contract tests are skipped when unset.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pixeltown_test
