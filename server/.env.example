# Anthropic API key — read only by the server, never sent to the browser.
ANTHROPIC_API_KEY=
# 1 = deterministic mock LLM (no key needed; the on-stage fallback).
# 0 = live Claude calls. With no key set the server falls back to mock automatically.
MOCK_LLM=0
# Optional: override the model (default claude-haiku-4-5-20251001).
# LLM_MODEL=
PORT=3001
