    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "socket.io": "^4.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.15",
